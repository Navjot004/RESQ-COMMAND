# ── SAR Platform Backend — Environment Variables ──────
# Copy this to .env and fill in your values

# ── Database ──────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://sar_user:your_password@localhost:5432/sar_platform
SYNC_DATABASE_URL=postgresql://sar_user:your_password@localhost:5432/sar_platform

# ── Redis ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── JWT Authentication ────────────────────────────────
SECRET_KEY=your-secret-key-here-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── App Settings ──────────────────────────────────────
APP_NAME=SAR Command Platform
APP_VERSION=1.0.0
DEBUG=true
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:5500"]

# ── Admin User ────────────────────────────────────────
FIRST_SUPERUSER_EMAIL=admin@sar.command
FIRST_SUPERUSER_PASSWORD=changeme123
